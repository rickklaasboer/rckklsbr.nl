APP_NAME=rckklsbr.nl
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rckklsbr.nl
APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl

# Cloudflare Turnstile widget for rckklsbr.nl
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# read by compose.prod.yaml
APP_BIND=127.0.0.1
APP_PORT=8095
APP_TAG=latest

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rckklsbr
DB_USERNAME=rckklsbr
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
